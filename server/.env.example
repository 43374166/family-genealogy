# Local development only. Never commit real secrets.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_DSN=familytree:change-me@tcp(127.0.0.1:3306)/familytree?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=15s

# Used by compose.yaml only. Keep MYSQL_PASSWORD in sync with DATABASE_DSN.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
