# Local development only. Never commit real secrets.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_DSN=familytree:change-me@tcp(127.0.0.1:3306)/familytree?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=15s

# Used by compose.yaml only. Keep MYSQL_PASSWORD in sync with DATABASE_DSN.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

# Family photo storage (private Huawei OBS bucket).
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_ACCESS_KEY_ID=
OBS_SECRET_KEY=
OBS_BUCKET_NAME=fishdream-family
OBS_UPLOAD_PREFIX=familytree

# Phone verification. Use SMS_PROVIDER=mock only for local development.
OTP_PEPPER=change-me-to-a-long-random-value
SMS_PROVIDER=disabled
HUAWEI_SMS_APP_KEY=
HUAWEI_SMS_APP_SECRET=
HUAWEI_SMS_FROM=
HUAWEI_SMS_TEMPLATE_ID=
HUAWEI_SMS_SIGNATURE=
HUAWEI_SMS_REGION=cn-north-4
